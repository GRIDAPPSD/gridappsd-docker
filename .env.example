# Environment variables for the GridAPPS-D observability stack.
# Copy this file to .env or export these variables in your shell before
# running run.sh or observability-up.sh when the observability overlay is active.
#
# Only variables relevant to observability are listed here.  The core
# platform variable (GRIDAPPSD_TAG) is written by run.sh automatically.

# ----------------------------------------------------------------------------
# REQUIRED when the observability overlay is active
# (docker-compose.d/docker-compose-grafana.yml is present)
# ----------------------------------------------------------------------------

# Grafana admin password.  Must be set to a non-empty value.
# Grafana 10.x falls back to its built-in admin default when this is empty,
# which restores the admin/admin exposure GADO-007 was filed to close.
# The launcher (run.sh / observability-up.sh) refuses to start when this is
# unset or empty.  There is no default here by design.
GRAFANA_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# OPTIONAL -- shown with their defaults
# ----------------------------------------------------------------------------

# Grafana admin username (default: admin).
# GRAFANA_ADMIN_USER=admin

# Bind address for all observability host-port publishes.
# Default is 127.0.0.1 (loopback, accessible only from this machine).
# Set to 0.0.0.0 only on a trusted, firewalled network when off-host access
# to Grafana/Prometheus/Loki/Tempo/OTLP is genuinely required.
# OBSERVABILITY_BIND_HOST=127.0.0.1

# Enable anonymous (unauthenticated) read-only access to Grafana.
# Default is false.  Set to true only for dev/demo in a trusted environment.
# GRAFANA_ANONYMOUS_ENABLED=false
